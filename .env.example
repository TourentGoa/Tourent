# Server Port
PORT=5001

# MongoDB Atlas Cloud Database URI
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/tourent_db?retryWrites=true&w=majority

# Automated Email Configuration (Gmail App Password or SMTP)
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_16_digit_app_password

# Admin Authentication
ADMIN_USERNAME=admin
ADMIN_PASSWORD=YourStrongAdminPassword123!
JWT_SECRET=your_jwt_secret_key_minimum_32_characters

# Razorpay Online Payment Gateway
RAZORPAY_KEY_ID=rzp_live_or_test_key_id
RAZORPAY_KEY_SECRET=rzp_secret_key
RAZORPAY_WEBHOOK_SECRET=webhook_secret_string
